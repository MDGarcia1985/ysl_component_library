{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ysl:schema:component:1.0.0-draft.1",
  "title": "Hardware component — review draft",
  "$comment": "Draft for human review, not adopted by the hardware catalog. Related decision: DEV-2026-11-19-004.",
  "x-ysl-review-status": "draft-not-approved",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft.1"
    },
    "id": {
      "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/component_id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "category": {
      "enum": [
        "controllers",
        "drivers",
        "sensors",
        "actuators",
        "interfaces",
        "power",
        "connectors"
      ]
    },
    "kind": {
      "enum": [
        "board",
        "ic_family",
        "module"
      ]
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "name": false
            }
          }
        }
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "provenance": {
      "$ref": "urn:ysl:schema:provenance:1.0.0-draft.1#/$defs/provenance"
    },
    "sources": {
      "$ref": "urn:ysl:schema:provenance:1.0.0-draft.1#/$defs/sources"
    },
    "verification": {
      "$ref": "urn:ysl:schema:provenance:1.0.0-draft.1#/$defs/verification"
    },
    "facts": {
      "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/facts"
    },
    "pins": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/pin"
      },
      "minProperties": 1
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/connector"
      },
      "minProperties": 0
    },
    "interfaces": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/interface"
      },
      "minProperties": 0
    },
    "onboard_components": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/part"
      },
      "minProperties": 0
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/feature"
      },
      "minProperties": 0
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/variant"
      },
      "minProperties": 0
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/profile"
      },
      "minProperties": 0
    },
    "connections": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:relations:1.0.0-draft.1#/$defs/connection"
      },
      "minProperties": 0
    },
    "resource_conflicts": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:relations:1.0.0-draft.1#/$defs/resource_conflict"
      },
      "minProperties": 0
    },
    "power_domains": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:relations:1.0.0-draft.1#/$defs/power_domain"
      },
      "minProperties": 0
    },
    "constraints": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ysl:schema:common:1.0.0-draft.1#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "urn:ysl:schema:relations:1.0.0-draft.1#/$defs/constraint"
      },
      "minProperties": 0
    },
    "board": {
      "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/board"
    },
    "ic_family": {
      "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/ic_family"
    },
    "module": {
      "$ref": "urn:ysl:schema:hardware:1.0.0-draft.1#/$defs/module"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "kind",
    "manufacturer",
    "aliases",
    "provenance",
    "sources",
    "verification",
    "facts",
    "pins",
    "connectors",
    "interfaces"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "board"
          }
        }
      },
      "then": {
        "required": [
          "board"
        ],
        "properties": {
          "ic_family": false,
          "module": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ic_family"
          }
        }
      },
      "then": {
        "required": [
          "ic_family",
          "variants"
        ],
        "properties": {
          "board": false,
          "module": false,
          "variants": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "module"
          }
        }
      },
      "then": {
        "required": [
          "module"
        ],
        "properties": {
          "board": false,
          "ic_family": false
        }
      }
    }
  ]
}
